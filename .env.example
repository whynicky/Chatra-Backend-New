# Шаблон окружения backend. Скопируйте в .env и заполните реальные значения.
# Секреты НИКОГДА не коммитятся и не попадают в Dockerfile.

# ─── Database ────────────────────────────────────────────────────────────────
# db — имя сервиса из docker-compose.yml (НЕ localhost).
DATABASE_URL=postgresql://chatra:replace-with-local-password@db:5432/chatra

# ─── Security ────────────────────────────────────────────────────────────────
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
REFRESH_SECRET_KEY=change-me-too

# Environment controls secure defaults. Use production in every deployed API.
APP_ENV=development
# Browser refresh-session cookie. Secure must stay true in production.
AUTH_COOKIE_SECURE=false
# Lax is recommended for a same-site frontend/API. Use none only for a truly
# cross-site HTTPS deployment and keep CSRF protection enabled.
AUTH_COOKIE_SAMESITE=lax
# Optional shared parent domain, for example .chatra.example.com.
AUTH_COOKIE_DOMAIN=

# ─── CORS / публичный адрес ──────────────────────────────────────────────────
# Домен(а) фронтенда через запятую. Пусто/"*" = все origin'ы без credentials.
CORS_ORIGINS=https://chatra.example.com
# Публичный URL бэкенда — база подписанных ссылок на файлы.
APP_BASE_URL=https://chatra.example.com

# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Chatra

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
DID_API_KEY=
ELEVENLABS_API_KEY=

# ─── Firebase push (один из двух) ────────────────────────────────────────────
# Вариант compose: файл монтируется как /run/secrets/firebase-sa.json.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-sa.json
# Либо инлайн-содержимое JSON ключа:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Опциональные ────────────────────────────────────────────────────────────
# UPLOAD_DIR=uploads
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# FILE_URL_TTL=86400
# AI_DAILY_TOKEN_BUDGET=2000000
# REDIS_URL=redis://redis:6379/0   # общий rate-limiter между воркерами
# BACKGROUND_JOBS_ENABLED=0         # run jobs in exactly one dedicated process
